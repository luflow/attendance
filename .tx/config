[main]
host = https://www.transifex.com
# de and de_DE are maintained by hand in this repo and must not come back from
# Transifex — repeated syncs overwrote reviewed German with worse wording and
# broke placeholders. There is no "exclude language" option in this file, and
# the Nextcloud bot always runs `tx pull -f -a`, so both are mapped to a local
# directory starting with a dot: translationtool's findLanguages() skips those,
# leaving l10n/de.* and l10n/de_DE.* untouched. Everything else still syncs.
lang_map = hu_HU: hu, nb_NO: nb, sk_SK: sk, th_TH: th, ja_JP: ja, bg_BG: bg, cs_CZ: cs, fi_FI: fi, de: .frozen-de, de_DE: .frozen-de_DE

[o:nextcloud:p:nextcloud:r:attendance]
file_filter = translationfiles/<lang>/attendance.po
source_file = translationfiles/templates/attendance.pot
source_lang = en
type = PO
